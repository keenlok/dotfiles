# Ubuntu/Linux zsh config for this dotfiles repo.
# Keeps the shared prompt from .zprofile and only loads tools when present.

HISTFILE="${HOME}/.histfile"
HISTSIZE=10000
SAVEHIST=1000

setopt appendhistory
setopt extendedglob
setopt no_beep
unsetopt nomatch

bindkey -e

zstyle :compinstall filename "${HOME}/.zshrc"
autoload -Uz compinit
compinit

if [[ -f "${HOME}/.zprofile" ]]; then
  source "${HOME}/.zprofile"
fi

typeset -U path PATH
path=(
  "${HOME}/.local/bin"
  "${HOME}/bin"
  /usr/local/bin
  /usr/bin
  /bin
  ${path}
)
export PATH

alias pip='pip3'
alias python='python3'

export NVM_DIR="${HOME}/.nvm"
if [[ -s "${NVM_DIR}/nvm.sh" ]]; then
  source "${NVM_DIR}/nvm.sh"
fi
if [[ -s "${NVM_DIR}/bash_completion" ]]; then
  source "${NVM_DIR}/bash_completion"
fi

if command -v pyenv >/dev/null 2>&1; then
  eval "$(pyenv init -)"
fi

if command -v jenv >/dev/null 2>&1; then
  export PATH="${HOME}/.jenv/bin:${PATH}"
  eval "$(jenv init -)"
fi

if [[ -f "${HOME}/.kubectl_aliases" ]]; then
  source "${HOME}/.kubectl_aliases"
fi

if [[ -f "${HOME}/.grabrc" ]]; then
  source "${HOME}/.grabrc"
fi

if [[ -f "${HOME}/.shortcuts/lazy.rc" ]]; then
  source "${HOME}/.shortcuts/lazy.rc"
fi

export PATH="${KREW_ROOT:-$HOME/.krew}/bin:${PATH}"
